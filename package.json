{
  "name": "mewcat-translation-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json && npm run build:client",
    "build:client": "esbuild client/browser.ts --bundle --platform=browser --format=esm --target=chrome120 --outfile=dist/client/mewcat.js",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/prepare-db.ts && prisma migrate deploy",
    "db:studio": "prisma studio",
    "admin": "tsx scripts/admin.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@prisma/adapter-better-sqlite3": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "dotenv": "^17.0.0",
    "fastify": "^5.0.0",
    "ipaddr.js": "^2.2.0",
    "jose": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.0.0",
    "prisma": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.3.6",
    "vitest": "4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.4"
  }
}
