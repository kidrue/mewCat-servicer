NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=file:./data/mewcat.db
KEYS_FILE=./secrets/server-keys.json

# 必填：从配置的上游供应商控制台获取，仅放在服务器。
SILICONFLOW_API_KEY=
# 必填：复制控制台当前可用模型 ID，选择支持 JSON 输出和非思考模式的文本模型。DeepSeek 官方接口可填 `deepseek-flash`。
SILICONFLOW_MODEL=
# DeepSeek 官方接口改为 https://api.deepseek.com。
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
UPSTREAM_TIMEOUT_MS=30000
MAX_OUTPUT_TOKENS=4096
MAX_CONCURRENT_REQUESTS=8

# 白名单统一维护在 config/allowed-origins.json，构建时校验并打包，自动部署时注入。
# 留空使用仓库白名单；需要临时覆盖时填逗号分隔的来源。不带 Origin 的调用仍需密钥认证。
ALLOWED_ORIGINS=
# 默认不信任 X-Forwarded-For。反向代理部署只填写真实代理 IP/CIDR。
# TRUST_PROXY=127.0.0.1,::1
TRUST_PROXY=
LOG_LEVEL=info

CLOCK_SKEW_MS=300000
INGRESS_REQUESTS_PER_MINUTE=120
CLIENT_REQUESTS_PER_MINUTE=20
IP_REQUESTS_PER_MINUTE=60
CLIENT_DAILY_CHARACTERS=20000
IP_DAILY_CHARACTERS=100000
GLOBAL_DAILY_CHARACTERS=1000000
GLOBAL_DAILY_REQUESTS=10000
# 公开设备自动注册的每 IP 每日上限。
REGISTRATIONS_PER_IP_PER_DAY=10
